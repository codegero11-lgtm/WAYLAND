<?xml version="1.0"?>
<package format="3">
  <name>aracne_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch and integration tests for Aracne Mark I.</description>
  <maintainer email="user@example.com">Aracne Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rclcpp</build_depend>
  <build_depend>ros2launch</build_depend>
  <build_depend>launch</build_depend>
  <build_depend>launch_ros</build_depend>
  <build_depend>ament_cmake_pytest</build_depend>
  <build_depend>aracne_msgs</build_depend>
  <build_depend>aracne_leg_kinematics</build_depend>
  <build_depend>aracne_simulation</build_depend>
  <build_depend>aracne_teleop</build_depend>
  <build_depend>controller_manager</build_depend>
  <build_depend>ros_gz_bridge</build_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
