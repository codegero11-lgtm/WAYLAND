  <exec_depend>launch_ros</exec_depend>
  <exec_depend>aracne_msgs</exec_depend>
  <exec_depend>aracne_leg_kinematics</exec_depend>
  <exec_depend>aracne_simulation</exec_depend>
  <exec_depend>aracne_teleop</exec_depend>
  <exec_depend>controller_manager</exec_depend>
